generator client {
  provider = "prisma-client-js"
  output   = "../lib/prisma-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id          Int     @id @default(autoincrement())
  username    String? @unique @db.VarChar(255)
  password    String? @db.VarChar(255)
  role        String? @db.VarChar(50)
  record_flag String? @default("ACTIVE") @db.VarChar(31)

  @@map("admin")
}

model User {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  password     String
  role         String           @default("ADMIN_FARM")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  beritaAcaras BeritaAcara[]
  outflows     MilkOutflow[]
  packagings   MilkPackaging[]
  productions  MilkProduction[]
  milkRequests MilkRequest[]
  sales        MilkSale[]
  logs         SystemLog[]

  @@map("users")
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  userEmail String   @map("user_email")
  action    String
  level     String   @default("INFO")
  details   String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "system_logs_user_id_fkey")
  @@map("system_logs")
}

model MilkCategory {
  id               String           @id @default(uuid())
  name             String           @unique
  code             String           @unique
  productType      String           @default("SEGAR") @map("product_type")
  animalType       String           @default("SAPI") @map("animal_type")
  defaultPackaging String           @default("botol") @map("default_packaging")
  description      String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  outflows         MilkOutflow[]
  packagings       MilkPackaging[]
  productions      MilkProduction[]

  @@map("milk_categories")
}

model MilkProduction {
  id                    String          @id @default(uuid())
  date                  DateTime        @default(now())
  categoryId            String          @map("category_id")
  productType           String          @default("SEGAR") @map("product_type")
  animalType            String          @default("SAPI") @map("animal_type")
  packagingType         String          @default("botol") @map("packaging_type")
  rawVolumeLiters       Float           @default(0) @map("raw_volume_liters")
  processedLiters       Float           @default(0) @map("processed_liters")
  packagedQty           Int             @default(0) @map("packaged_qty")
  status                String          @default("SELESAI")
  notes                 String?
  createdById           String?         @map("created_by_id")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  grossVolumeLiters     Float           @default(0) @map("gross_volume_liters")
  usageType             String?         @map("usage_type")
  usageVolumeLiters     Float           @default(0) @map("usage_volume_liters")
  afkirVolumeLiters     Float           @default(0) @map("afkir_volume_liters")
  pedetVolumeLiters     Float           @default(0) @map("pedet_volume_liters")
  farmOrigin            String          @default("Manggala") @map("farm_origin")
  shift                 String          @default("Pagi")
  keteranganPenjualan   String?         @map("keterangan_penjualan")
  soldFreshVolumeLiters Float           @default(0) @map("sold_fresh_volume_liters")
  fotoTimbangan         String?         @map("foto_timbangan") @db.LongText
  handoverStatus        String          @default("MENUNGGU_VERIFIKASI") @map("handover_status")
  kodeTransfer          String?         @unique @map("kode_transfer")
  nomorSegel            String?         @map("nomor_segel")
  pinVerifikasi         String?         @map("pin_verifikasi")
  receivedVolumeLiters  Float?          @map("received_volume_liters")
  beritaAcaras          BeritaAcara[]
  packagings            MilkPackaging[]
  category              MilkCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy             User?           @relation(fields: [createdById], references: [id])

  @@index([categoryId], map: "milk_productions_category_id_fkey")
  @@index([createdById], map: "milk_productions_created_by_id_fkey")
  @@map("milk_productions")
}

model MilkPackaging {
  id               String          @id @default(uuid())
  date             DateTime        @default(now())
  animalType       String          @default("SAPI") @map("animal_type")
  categoryId       String?         @map("category_id")
  processedLiters  Float           @default(0) @map("processed_liters")
  botolQty         Int             @default(0) @map("botol_qty")
  cupQty           Int             @default(0) @map("cup_qty")
  plastikBantalQty Int             @default(0) @map("plastik_bantal_qty")
  totalPackagedQty Int             @default(0) @map("total_packaged_qty")
  status           String          @default("DRAFT")
  notes            String?
  createdById      String?         @map("created_by_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  origin           String          @default("Sapi")
  packageSize      String?         @map("package_size")
  packagingDetails String?         @map("packaging_details") @db.Text
  packagingType    String?         @map("packaging_type")
  processedAmount  Float           @default(0) @map("processed_amount")
  processedUnit    String          @default("Liter") @map("processed_unit")
  productCategory  String          @default("Susu") @map("product_category")
  productSubtype   String?         @map("product_subtype")
  variant          String?
  condition        String?
  quantityReceived Int             @default(0) @map("quantity_received")
  quantitySent     Int             @default(0) @map("quantity_sent")
  receivedAt       DateTime?       @map("received_at")
  receivedById     String?         @map("received_by_id")
  receivedByName   String?         @map("received_by_name")
  receptionNotes   String?         @map("reception_notes") @db.Text
  sentAt           DateTime?       @map("sent_at")
  sentById         String?         @map("sent_by_id")
  sentByName       String?         @map("sent_by_name")
  productionId     String?         @map("production_id")
  category         MilkCategory?   @relation(fields: [categoryId], references: [id])
  createdBy        User?           @relation(fields: [createdById], references: [id])
  production       MilkProduction? @relation(fields: [productionId], references: [id])

  @@index([categoryId], map: "milk_packagings_category_id_fkey")
  @@index([createdById], map: "milk_packagings_created_by_id_fkey")
  @@index([productionId], map: "milk_packagings_production_id_fkey")
  @@map("milk_packagings")
}

model MilkOutflow {
  id            String       @id @default(uuid())
  date          DateTime     @default(now())
  categoryId    String       @map("category_id")
  productType   String       @default("SEGAR") @map("product_type")
  animalType    String       @default("SAPI") @map("animal_type")
  packagingType String       @default("botol") @map("packaging_type")
  quantity      Int          @default(0)
  notes         String?
  createdById   String?      @map("created_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  category      MilkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy     User?        @relation(fields: [createdById], references: [id])

  @@index([categoryId], map: "milk_outflows_category_id_fkey")
  @@index([createdById], map: "milk_outflows_created_by_id_fkey")
  @@map("milk_outflows")
}

model MilkSale {
  id               String   @id @default(uuid())
  transaction_id   String   @unique
  date             DateTime @default(now())
  product_category String   @default("Susu")
  product_subtype  String?
  variant          String?
  packagingType    String   @default("Botol") @map("packaging_type")
  quantity         Int      @default(0)
  unitPrice        Float    @default(0) @map("unit_price")
  totalPrice       Float    @default(0) @map("total_price")
  status           String   @default("Berhasil")
  notes            String?
  createdById      String?  @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        User?    @relation(fields: [createdById], references: [id])

  @@index([createdById], map: "milk_sales_created_by_id_fkey")
  @@map("milk_sales")
}

model BeritaAcara {
  id               String           @id @default(uuid())
  nomorBA          String           @unique @map("nomor_ba")
  date             DateTime         @default(now())
  shift            String?          @default("Pagi")
  farmLocation     String?          @default("Tegalsari") @map("farm_location")
  animalType       String?          @default("SAPI") @map("animal_type")
  unit             String?          @default("Liter")
  totalProduksi    Float?           @default(0) @map("total_produksi")
  penggunaanPedet  Float?           @default(0) @map("penggunaan_pedet")
  afkir            Float?           @default(0)
  lainLain         Float?           @default(0) @map("lain_lain")
  diserahterimakan Float?           @default(0)
  penerimaRole     String?          @default("Seksi Pemasaran") @map("penerima_role")
  penerimaUserId   String?          @map("penerima_user_id")
  penerimaName     String?          @default("Seksi Pemasaran") @map("penerima_name")
  penyerahRole     String?          @default("Seksi Pemeliharaan") @map("penyerah_role")
  penyerahUserId   String?          @map("penyerah_user_id")
  penyerahName     String?          @default("Seksi Pemeliharaan") @map("penyerah_name")
  status           String?          @default("DRAFT")
  digitalSignature String?          @map("digital_signature") @db.LongText
  signedAt         DateTime?        @map("signed_at")
  signedByName     String?          @map("signed_by_name")
  sentAt           DateTime?        @map("sent_at")
  readAt           DateTime?        @map("read_at")
  printedAt        DateTime?        @map("printed_at")
  notes            String?          @db.Text
  productionId     String?          @map("production_id")
  createdById      String?          @map("created_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  confirmedAt      DateTime?        @map("confirmed_at")
  confirmedBy      String?          @map("confirmed_by")
  confirmedByName  String?          @map("confirmed_by_name")
  giverDept        String?          @default("Tim Kerja Layanan Pemasaran") @map("giver_dept")
  giverName        String?          @default("Tim Kerja Layanan Pemasaran") @map("giver_name")
  giverTitle       String?          @map("giver_title")
  items            String?          @db.Text
  location         String?
  packagingId      String?          @map("packaging_id")
  period           String?
  purpose          String?
  receiverDept     String?          @map("receiver_dept")
  receiverName     String?          @map("receiver_name")
  receiverTitle    String?          @map("receiver_title")
  type             String?
  createdBy        User?            @relation(fields: [createdById], references: [id])
  production       MilkProduction?  @relation(fields: [productionId], references: [id])
  logs             BeritaAcaraLog[]

  @@index([createdById], map: "berita_acara_created_by_id_fkey")
  @@index([productionId], map: "berita_acara_production_id_fkey")
  @@map("berita_acara")
}

model BeritaAcaraLog {
  id            String      @id @default(uuid())
  beritaAcaraId String      @map("berita_acara_id")
  action        String
  actorName     String      @map("actor_name")
  actorRole     String?     @map("actor_role")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  beritaAcara   BeritaAcara @relation(fields: [beritaAcaraId], references: [id], onDelete: Cascade)

  @@index([beritaAcaraId], map: "berita_acara_logs_berita_acara_id_fkey")
  @@map("berita_acara_logs")
}

model MilkRequest {
  id                   String    @id @default(uuid())
  requestNo            String    @unique @map("request_no")
  date                 DateTime  @default(now())
  volumeLiters         Float     @default(0) @map("volume_liters")
  processingNeeds      String    @map("processing_needs")
  priority             String    @default("Normal")
  notes                String?   @db.Text
  status               String    @default("MENUNGGU_PERSETUJUAN")
  rejectionReason      String?   @map("rejection_reason") @db.Text
  approvedAt           DateTime? @map("approved_at")
  approvedById         String?   @map("approved_by_id")
  approvedByName       String?   @map("approved_by_name")
  dispatchedAt         DateTime? @map("dispatched_at")
  readyForReceiptAt    DateTime? @map("ready_for_receipt_at")
  receivedVolumeLiters Float?    @map("received_volume_liters")
  receivedAt           DateTime? @map("received_at")
  receivedById         String?   @map("received_by_id")
  receivedByName       String?   @map("received_by_name")
  createdById          String?   @map("created_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  createdBy            User?     @relation(fields: [createdById], references: [id])

  @@index([createdById], map: "milk_requests_created_by_id_fkey")
  @@map("milk_requests")
}

model PackagingMaterial {
  id            String                  @id @default(uuid())
  code          String                  @unique
  name          String
  category      String                  @default("Kemasan")
  unit          String                  @default("pcs")
  currentStock  Float                   @default(0) @map("current_stock")
  minimumStock  Float                   @default(500) @map("minimum_stock")
  criticalStock Float                   @default(200) @map("critical_stock")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  movements     MaterialStockMovement[]

  @@map("packaging_materials")
}

model MaterialStockMovement {
  id            String            @id @default(uuid())
  materialId    String            @map("material_id")
  type          String
  quantity      Float
  previousStock Float             @default(0) @map("previous_stock")
  newStock      Float             @default(0) @map("new_stock")
  source        String            @default("PENYESUAIAN")
  referenceId   String?           @map("reference_id")
  notes         String?           @db.Text
  createdById   String?           @map("created_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  material      PackagingMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId], map: "material_stock_movements_material_id_fkey")
  @@map("material_stock_movements")
}
