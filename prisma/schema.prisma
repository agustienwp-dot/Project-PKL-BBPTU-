generator client {
  provider = "prisma-client-js"
  output   = "../lib/prisma-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id          Int     @id @default(autoincrement())
  username    String? @unique @db.VarChar(255)
  password    String? @db.VarChar(255)
  role        String? @db.VarChar(50)
  record_flag String? @default("ACTIVE") @db.VarChar(31)

  @@map("admin")
}

model User {
  id               String           @id @default(uuid())
  name             String
  email            String           @unique
  password         String
  role             String           @default("ADMIN_FARM")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")
  milk_outflows    MilkOutflow[]
  milk_packagings  MilkPackaging[]
  milk_productions MilkProduction[]
  milk_sales       MilkSale[]
  system_logs      SystemLog[]

  @@map("users")
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String
  action    String
  level     String   @default("INFO")
  details   String?
  createdAt DateTime @default(now())
  users     User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "system_logs_userId_fkey")
  @@map("system_logs")
}

model MilkCategory {
  id               String           @id @default(uuid())
  name             String           @unique
  code             String           @unique
  productType      String           @default("SEGAR")
  animalType       String           @default("SAPI")
  defaultPackaging String           @default("botol")
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  milk_outflows    MilkOutflow[]
  milk_packagings  MilkPackaging[]
  milk_productions MilkProduction[]

  @@map("milk_categories")
}

model MilkProduction {
  id                String       @id @default(uuid())
  date              DateTime     @default(now())
  categoryId        String
  productType       String       @default("SEGAR")
  animalType        String       @default("SAPI")
  packagingType     String       @default("botol")
  grossVolumeLiters Float        @default(0)
  pedetVolumeLiters Float        @default(0)
  afkirVolumeLiters Float        @default(0)
  usageType         String?
  usageVolumeLiters Float        @default(0)
  rawVolumeLiters   Float        @default(0)
  processedLiters   Float        @default(0)
  packagedQty       Int          @default(0)
  status            String       @default("SELESAI")
  notes             String?
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime
  milk_categories   MilkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users             User?        @relation(fields: [createdById], references: [id])

  @@index([categoryId], map: "milk_productions_categoryId_fkey")
  @@index([createdById], map: "milk_productions_createdById_fkey")
  @@map("milk_productions")
}

model MilkPackaging {
  id               String        @id @default(uuid())
  date             DateTime      @default(now())
  productCategory  String        @default("Susu")
  productSubtype   String?
  origin           String        @default("Sapi")
  variant          String?
  animalType       String        @default("SAPI")
  categoryId       String?
  processedAmount  Float         @default(0)
  processedUnit    String        @default("Liter")
  processedLiters  Float         @default(0)
  packagingDetails String?       @db.Text
  packagingType    String?
  packageSize      String?
  botolQty         Int           @default(0)
  cupQty           Int           @default(0)
  plastikBantalQty Int           @default(0)
  totalPackagedQty Int           @default(0)
  status           String        @default("DRAFT")
  sentAt           DateTime?
  sentById         String?
  sentByName       String?
  receivedAt       DateTime?
  receivedById     String?
  receivedByName   String?
  quantitySent     Int           @default(0)
  quantityReceived Int           @default(0)
  condition        String?
  receptionNotes   String?       @db.Text
  notes            String?
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  milk_categories  MilkCategory? @relation(fields: [categoryId], references: [id])
  users            User?         @relation(fields: [createdById], references: [id])

  @@index([categoryId], map: "milk_packagings_categoryId_fkey")
  @@index([createdById], map: "milk_packagings_createdById_fkey")
  @@map("milk_packagings")
}

model MilkOutflow {
  id              String       @id @default(uuid())
  date            DateTime     @default(now())
  categoryId      String
  productType     String       @default("SEGAR")
  animalType      String       @default("SAPI")
  packagingType   String       @default("botol")
  quantity        Int          @default(0)
  notes           String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  milk_categories MilkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users           User?        @relation(fields: [createdById], references: [id])

  @@index([categoryId], map: "milk_outflows_categoryId_fkey")
  @@index([createdById], map: "milk_outflows_createdById_fkey")
  @@map("milk_outflows")
}

model MilkSale {
  id              String   @id @default(uuid())
  transactionId   String   @unique
  date            DateTime @default(now())
  productCategory String   @default("Susu")
  productSubtype  String?
  variant         String?
  packagingType   String   @default("Botol")
  quantity        Int      @default(0)
  unitPrice       Float    @default(0)
  totalPrice      Float    @default(0)
  status          String   @default("Berhasil")
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  users           User?    @relation(fields: [createdById], references: [id])

  @@index([createdById], map: "milk_sales_createdById_fkey")
  @@map("milk_sales")
}

model BeritaAcara {
  id            String   @id @default(uuid())
  nomorBA       String   @unique
  type          String   @db.VarChar(50)
  date          DateTime @default(now())
  period        String?  @db.VarChar(50)
  location      String?  @db.VarChar(100)
  giverName     String   @default("Tim Kerja Layanan Pemasaran") @db.VarChar(255)
  giverTitle    String?  @db.VarChar(255)
  giverDept     String?  @default("Tim Kerja Layanan Pemasaran") @db.VarChar(255)
  receiverName  String   @db.VarChar(255)
  receiverTitle String?  @db.VarChar(255)
  receiverDept  String?  @db.VarChar(255)
  purpose       String?  @db.VarChar(255)
  notes         String?  @db.Text
  items         String   @db.Text
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@map("berita_acara")
}

model MilkRequest {
  id                   String    @id @default(uuid())
  requestNo            String    @unique
  date                 DateTime  @default(now())
  volumeLiters         Float     @default(0)
  processingNeeds      String    @db.VarChar(255)
  priority             String    @default("Normal") @db.VarChar(50)
  notes                String?   @db.Text
  status               String    @default("MENUNGGU_PERSETUJUAN") @db.VarChar(50)
  rejectionReason      String?   @db.Text
  approvedAt           DateTime?
  approvedById         String?
  approvedByName       String?   @db.VarChar(255)
  dispatchedAt         DateTime?
  readyForReceiptAt    DateTime?
  receivedVolumeLiters Float?
  receivedAt           DateTime?
  receivedById         String?
  receivedByName       String?   @db.VarChar(255)
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  @@map("milk_requests")
}

model PackagingMaterial {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String   @db.VarChar(255)
  category      String   @default("Kemasan") @db.VarChar(100)
  unit          String   @default("pcs") @db.VarChar(50)
  currentStock  Float    @default(0)
  minimumStock  Float    @default(500)
  criticalStock Float    @default(200)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@map("packaging_materials")
}

model MaterialStockMovement {
  id            String   @id @default(uuid())
  materialId    String
  type          String   @db.VarChar(50)
  quantity      Float    @default(0)
  previousStock Float    @default(0)
  newStock      Float    @default(0)
  source        String   @default("PENYESUAIAN") @db.VarChar(50)
  referenceId   String?
  notes         String?  @db.Text
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([materialId], map: "material_stock_movements_materialId_fkey")
  @@map("material_stock_movements")
}
