generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id          Int     @id @default(autoincrement())
  username    String? @unique @db.VarChar(255)
  password    String? @db.VarChar(255)
  role        String? @db.VarChar(50)
  record_flag String? @default("ACTIVE") @db.VarChar(31)

  @@map("admin")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN_FARM") // SUPERADMIN, ADMIN_FARM, ADMIN_PEMASARAN
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs        SystemLog[]
  productions MilkProduction[]
  packagings  MilkPackaging[]
  outflows    MilkOutflow[]
  sales       MilkSale[]
  beritaAcaras BeritaAcara[]

  @@map("users")
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String
  action    String
  level     String   @default("INFO") // INFO, WARN, ERROR
  details   String?
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model MilkCategory {
  id               String   @id @default(uuid())
  name             String   @unique // e.g. Susu Murni Segar, Susu Olahan Cokelat, Yogurt, Keju
  code             String   @unique // e.g. SEGAR_MURNI, OLAHAN_COKELAT, YOGURT
  productType      String   @default("SEGAR") // "SEGAR" or "OLAHAN"
  animalType       String   @default("SAPI") // "SAPI" or "KAMBING"
  defaultPackaging String   @default("botol") // "cup", "pack", "botol", "liter"
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productions MilkProduction[]
  packagings  MilkPackaging[]
  outflows    MilkOutflow[]

  @@map("milk_categories")
}

model MilkProduction {
  id              String   @id @default(uuid())
  date            DateTime @default(now())
  shift           String   @default("Pagi") // "Pagi" or "Sore"
  farmOrigin      String   @default("Manggala") // "Manggala", "Limpakuwus", "Tegal Sari", "Eduwisata"
  categoryId      String
  category        MilkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productType     String   @default("SEGAR") // "SEGAR" or "OLAHAN"
  animalType      String   @default("SAPI") // "SAPI" or "KAMBING"
  packagingType   String   @default("botol") // "cup", "pack", "botol", "liter"
  grossVolumeLiters Float    @default(0) // Produksi susu (Gross Liter)
  pedetVolumeLiters Float    @default(0) // Susu untuk Pedet (Sapi) / Cempe (Kambing) (Liter)
  afkirVolumeLiters Float    @default(0) // Susu Afkir / Rusak (Liter)
  soldFreshVolumeLiters Float @default(0) // Susu Dijual Langsung Pasca Perah (Liter)
  keteranganPenjualan String? // Catatan/Keterangan Pembeli
  usageType       String?  // Ringkasan kegunaan / catatan alokasi
  usageVolumeLiters Float  @default(0) // Total potongan volume (pedet + afkir + dijual segar)
  rawVolumeLiters Float    @default(0) // Susu siap olah (gross - pedet - afkir - dijual segar)
  processedLiters Float    @default(0) // Input jumlah susu yang diproses/dikemas (liter)
  packagedQty     Int      @default(0) // Input jumlah produk setelah dikemas (botol/cup/pack)
  status          String   @default("SELESAI") // "SELESAI"
  notes           String?

  // Anti-Cheat & Verification Handshake fields
  kodeTransfer         String?  @unique
  fotoTimbangan        String?  @db.LongText
  nomorSegel           String?
  pinVerifikasi        String?
  handoverStatus       String   @default("MENUNGGU_VERIFIKASI") // "MENUNGGU_VERIFIKASI", "DITERIMA", "ADA_SELISIH"
  receivedVolumeLiters Float?

  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  beritaAcaras    BeritaAcara[]

  @@map("milk_productions")
}

model MilkPackaging {
  id               String   @id @default(uuid())
  date             DateTime @default(now())
  productCategory  String   @default("Susu") // "Susu", "Yogurt", "Keju"
  productSubtype   String?  // "Susu UHT", "Susu Pasteurisasi", "Susu Rasa"
  origin           String   @default("Sapi") // "Sapi", "Kambing"
  variant          String?  // "Original", "Cokelat", "Stroberi", "Melon", "Vanilla", "Keju Fresh", "Keju Olahan", dll.
  animalType       String   @default("SAPI") // "SAPI" or "KAMBING" (compat)
  categoryId       String?
  category         MilkCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  processedAmount  Float    @default(0) // Jumlah liter/kg yang diproses
  processedUnit    String   @default("Liter") // "Liter" or "Kg"
  processedLiters  Float    @default(0) // Quantified in liters for compat
  packagingDetails String?  @db.Text // JSON string: [{ packagingType, size, quantity }]
  packagingType    String?  // Main packaging type e.g. "Botol", "Cup"
  packageSize      String?  // Main package size e.g. "250 ml", "100 gram"
  botolQty         Int      @default(0) // Jumlah pcs botol (compat)
  cupQty           Int      @default(0) // Jumlah pcs cup (compat)
  plastikBantalQty Int      @default(0) // Jumlah pcs plastik bantal (compat)
  totalPackagedQty Int      @default(0) // Total pcs produk jadi
  status           String   @default("DRAFT") // "DRAFT", "MENUNGGU_PENERIMAAN", "DITERIMA", "PERLU_KOREKSI"
  sentAt           DateTime?
  sentById         String?
  sentByName       String?
  receivedAt       DateTime?
  receivedById     String?
  receivedByName   String?
  quantitySent     Int      @default(0) // Total pcs dikirim Farm
  quantityReceived Int      @default(0) // Total pcs dikonfirmasi Pemasaran
  condition        String?  // "Sesuai", "Ada Selisih", "Ada Kerusakan"
  receptionNotes   String?  @db.Text
  notes            String?
  createdById      String?
  createdBy        User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("milk_packagings")
}

model MilkOutflow {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  categoryId    String
  category      MilkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productType   String   @default("SEGAR") // "SEGAR" or "OLAHAN"
  animalType    String   @default("SAPI") // "SAPI" or "KAMBING"
  packagingType String   @default("botol") // "cup", "pack", "botol", "liter"
  quantity      Int      @default(0) // Jumlah produk yang keluar/terjual (botol/cup/pack)
  notes         String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("milk_outflows")
}

model MilkSale {
  id              String   @id @default(uuid())
  transactionId   String   @unique // e.g. TRX-20260814-001
  date            DateTime @default(now())
  productCategory String   @default("Susu") // "Susu", "Yogurt", "Keju"
  productSubtype  String?  // "Susu UHT", "Susu Pasteurisasi", "Susu Rasa", etc.
  variant         String?  // "Original", "Cokelat", etc.
  packagingType   String   @default("Botol") // "Botol", "Cup", "Plastik Bantal", etc.
  quantity        Int      @default(0) // Jumlah pcs
  unitPrice       Float    @default(0) // Harga per pcs
  totalPrice      Float    @default(0) // Total Rp
  status          String   @default("Berhasil") // "Berhasil", "Dibatalkan"
  notes           String?
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("milk_sales")
}

model BeritaAcara {
  id               String      @id @default(uuid())
  nomorBa          String      @unique // e.g. BA-20260819-001
  date             DateTime    @default(now())
  shift            String      @default("Pagi") // "Pagi" or "Sore"
  farmLocation     String      @default("Tegalsari") // "Tegalsari", "Limpakuwus", "Manggala", "Eduwisata"
  animalType       String      @default("SAPI") // "SAPI" or "KAMBING"
  unit             String      @default("Liter") // "Liter" or "Kg"

  // Quantities
  totalProduksi    Float       @default(0) // Total gross production
  penggunaanPedet  Float       @default(0) // Pedet / Cempe
  afkir            Float       @default(0) // Susu afkir
  lainLain         Float       @default(0) // Alokasi lain-lain
  diserahterimakan Float       @default(0) // Volume diserahterimakan ke Pemasaran

  // Pihak Pemasaran (Recipient)
  penerimaRole     String      @default("Seksi Pemasaran")
  penerimaUserId   String?
  penerimaName     String      @default("Seksi Pemasaran")

  // Pihak Pemeliharaan / Farm (Sender)
  penyerahRole     String      @default("Seksi Pemeliharaan")
  penyerahUserId   String?
  penyerahName     String      @default("Seksi Pemeliharaan")

  // Digital Signature & Workflow Status
  // "DRAFT", "MENUNGGU_TANDA_TANGAN", "SUDAH_DITANDATANGANI", "TERKIRIM_KE_PEMASARAN", "DIBACA_PEMASARAN", "DICETAK"
  status           String      @default("DRAFT")
  digitalSignature String?     @db.LongText
  signedAt         DateTime?
  signedByName     String?
  sentAt           DateTime?
  readAt           DateTime?
  printedAt        DateTime?

  notes            String?     @db.Text

  // Relation to MilkProduction
  productionId     String?
  production       MilkProduction? @relation(fields: [productionId], references: [id], onDelete: SetNull)

  createdById      String?
  createdBy        User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  logs             BeritaAcaraLog[]

  @@map("berita_acara")
}

model BeritaAcaraLog {
  id            String      @id @default(uuid())
  beritaAcaraId String
  beritaAcara   BeritaAcara @relation(fields: [beritaAcaraId], references: [id], onDelete: Cascade)
  action        String      // "DRAFT_CREATED", "EDITED", "SIGNED", "SENT", "READ", "PRINTED"
  actorName     String
  actorRole     String?
  notes         String?
  createdAt     DateTime    @default(now())

  @@map("berita_acara_logs")
}
