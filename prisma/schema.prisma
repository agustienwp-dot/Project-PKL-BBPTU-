generator client {
  provider = "prisma-client-js"
  output   = "../lib/prisma-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id          Int     @id @default(autoincrement())
  username    String? @unique @db.VarChar(255)
  password    String? @db.VarChar(255)
  role        String? @db.VarChar(50)
  record_flag String? @default("ACTIVE") @db.VarChar(31)

  @@map("admin")
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  role             String            @default("ADMIN_FARM")
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  bastDocuments    BastDocument[]
  milk_outflows    MilkOutflow[]
  milk_packagings  MilkPackaging[]
  milk_productions MilkProduction[]
  milk_sales       MilkSale[]
  packagedProducts PackagedProduct[] @relation("UserPackagedProducts")
  system_logs      SystemLog[]

  @@map("users")
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String
  action    String
  level     String   @default("INFO")
  details   String?
  createdAt DateTime @default(now())
  users     User?    @relation(fields: [userId], references: [id])

  @@index([userId], map: "system_logs_userId_fkey")
  @@map("system_logs")
}

model MilkCategory {
  id               String           @id @default(uuid())
  name             String           @unique
  code             String           @unique
  productType      String           @default("SEGAR")
  animalType       String           @default("SAPI")
  defaultPackaging String           @default("botol")
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  milk_outflows    MilkOutflow[]
  milk_packagings  MilkPackaging[]
  milk_productions MilkProduction[]

  @@map("milk_categories")
}

model MilkProduction {
  id                String        @id @default(uuid())
  date              DateTime      @default(now())
  categoryId        String?
  productType       String        @default("SEGAR")
  animalType        String        @default("SAPI")
  packagingType     String        @default("botol")
  grossVolumeLiters Float         @default(0)
  pedetVolumeLiters Float         @default(0)
  afkirVolumeLiters Float         @default(0)
  usageType         String?
  usageVolumeLiters Float         @default(0)
  rawVolumeLiters   Float         @default(0)
  processedLiters   Float         @default(0)
  packagedQty       Int           @default(0)
  status            String        @default("SELESAI")
  notes             String?
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  kirimKePI         Float         @default(0)
  produksi          Float         @default(0)
  rusakAfkir        Float         @default(0)
  setorPedet        Float         @default(0)
  tanggal           DateTime      @default(now())
  milk_categories   MilkCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users             User?         @relation(fields: [createdById], references: [id])

  @@index([categoryId], map: "milk_productions_categoryId_fkey")
  @@index([createdById], map: "milk_productions_createdById_fkey")
  @@map("milk_productions")
}

model PackagedProduct {
  id             String    @id @default(uuid())
  tanggal        DateTime  @default(now())
  jenisProduk    String
  kemasan        String
  jumlah         Float     @default(0)
  createdAt      DateTime  @default(now())
  condition      String?
  createdById    String?
  notes          String?   @db.Text
  receivedAt     DateTime?
  receivedByName String?
  status         String    @default("DITERIMA")
  updatedAt      DateTime  @updatedAt
  createdBy      User?     @relation("UserPackagedProducts", fields: [createdById], references: [id])

  @@index([createdById], map: "packaged_products_createdById_fkey")
  @@map("packaged_products")
}

model MilkPackaging {
  id               String        @id @default(uuid())
  date             DateTime      @default(now())
  productCategory  String        @default("Susu")
  productSubtype   String?
  origin           String        @default("Sapi")
  variant          String?
  animalType       String        @default("SAPI")
  categoryId       String?
  processedAmount  Float         @default(0)
  processedUnit    String        @default("Liter")
  processedLiters  Float         @default(0)
  packagingDetails String?       @db.Text
  packagingType    String?
  packageSize      String?
  botolQty         Int           @default(0)
  cupQty           Int           @default(0)
  plastikBantalQty Int           @default(0)
  totalPackagedQty Int           @default(0)
  status           String        @default("DITERIMA")
  sentAt           DateTime?
  sentById         String?
  sentByName       String?
  receivedAt       DateTime?
  receivedById     String?
  receivedByName   String?
  quantitySent     Int           @default(0)
  quantityReceived Int           @default(0)
  condition        String?
  receptionNotes   String?       @db.Text
  notes            String?
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  milk_categories  MilkCategory? @relation(fields: [categoryId], references: [id])
  users            User?         @relation(fields: [createdById], references: [id])

  @@index([categoryId], map: "milk_packagings_categoryId_fkey")
  @@index([createdById], map: "milk_packagings_createdById_fkey")
  @@map("milk_packagings")
}

model MilkOutflow {
  id              String       @id @default(uuid())
  date            DateTime     @default(now())
  categoryId      String
  productType     String       @default("SEGAR")
  animalType      String       @default("SAPI")
  packagingType   String       @default("botol")
  quantity        Int          @default(0)
  notes           String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  milk_categories MilkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  users           User?        @relation(fields: [createdById], references: [id])

  @@index([categoryId], map: "milk_outflows_categoryId_fkey")
  @@index([createdById], map: "milk_outflows_createdById_fkey")
  @@map("milk_outflows")
}

model MilkSale {
  id              String   @id @default(uuid())
  transactionId   String?  @unique
  date            DateTime @default(now())
  productCategory String   @default("Susu")
  productSubtype  String?
  variant         String?
  packagingType   String   @default("Botol")
  quantity        Int      @default(0)
  unitPrice       Float    @default(0)
  totalPrice      Float    @default(0)
  status          String   @default("Berhasil")
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  catatan         String?
  hargaJual       Float    @default(0)
  jumlah          Float    @default(0)
  kategoriBayar   String   @default("PNBP")
  pembeli         String   @default("")
  produkRefId     String?
  sumber          String   @default("FRESH")
  tanggal         DateTime @default(now())
  users           User?    @relation(fields: [createdById], references: [id])
  piutang         Piutang?

  @@index([createdById], map: "milk_sales_createdById_fkey")
  @@map("milk_sales")
}

model BastDocument {
  id               String    @id @default(uuid())
  nomorBast        String    @unique
  tanggal          DateTime  @default(now())
  sumber           String    @default("SUSU_SEGAR")
  volumeLiters     Float     @default(0)
  pengirimNama     String
  pengirimRole     String    @default("ADMIN_FARM")
  penerimaNama     String?
  penerimaRole     String?   @default("ADMIN_PEMASARAN")
  status           String    @default("MENUNGGU_KONFIRMASI")
  catatan          String?   @db.Text
  confirmedAt      DateTime?
  productionId     String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  instansiPenerima String?
  jenisPermintaan  String    @default("PENJUALAN_LANGSUNG")
  createdBy        User?     @relation(fields: [createdById], references: [id])

  @@index([createdById], map: "bast_documents_createdById_fkey")
  @@map("bast_documents")
}

model Notification {
  id           String    @id @default(uuid())
  title        String
  message      String    @db.Text
  type         String    @default("STOCK_ADDED")
  targetRole   String?
  targetUserId String?
  senderId     String?
  senderName   String?
  senderRole   String?
  link         String?   @default("/pemasaran/terima-data")
  isRead       Boolean   @default(false)
  readAt       DateTime?
  metadata     String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("notifications")
}

model MilkRequest {
  id                   String    @id @default(uuid())
  requestNo            String    @unique
  date                 DateTime  @default(now())
  volumeLiters         Float     @default(0)
  processingNeeds      String    @db.VarChar(255)
  priority             String    @default("Normal") @db.VarChar(50)
  notes                String?   @db.Text
  status               String    @default("MENUNGGU_PERSETUJUAN") @db.VarChar(50)
  rejectionReason      String?   @db.Text
  approvedAt           DateTime?
  approvedById         String?
  approvedByName       String?   @db.VarChar(255)
  dispatchedAt         DateTime?
  readyForReceiptAt    DateTime?
  receivedVolumeLiters Float?
  receivedAt           DateTime?
  receivedById         String?
  receivedByName       String?   @db.VarChar(255)
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  @@map("milk_requests")
}

model Piutang {
  id               String             @id @default(uuid())
  milkSaleId       String             @unique @map("milkSaleId")
  jumlahAwal       Float
  sisaPiutang      Float
  lunas            Boolean            @default(false)
  createdAt        DateTime           @default(now())
  pelunasanPiutang PelunasanPiutang[]
  milkSale         MilkSale           @relation(fields: [milkSaleId], references: [id], onDelete: Cascade)

  @@map("piutang")
}

model PelunasanPiutang {
  id        String   @id @default(uuid())
  piutangId String
  jumlah    Float
  tanggal   DateTime @default(now())
  catatan   String?
  piutang   Piutang  @relation(fields: [piutangId], references: [id], onDelete: Cascade)

  @@index([piutangId], map: "pelunasan_piutang_piutangId_fkey")
  @@map("pelunasan_piutang")
}
