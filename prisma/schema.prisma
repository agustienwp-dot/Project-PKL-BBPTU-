generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN_FARM") // SUPERADMIN, ADMIN_FARM, ADMIN_PEMASARAN
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs        SystemLog[]
  productions MilkProduction[]
  outflows    MilkOutflow[]

  @@map("users")
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String
  action    String
  level     String   @default("INFO") // INFO, WARN, ERROR
  details   String?
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model MilkCategory {
  id               String   @id @default(uuid())
  name             String   @unique // e.g. Susu Murni Segar, Susu Olahan Cokelat, Yogurt, Keju
  code             String   @unique // e.g. SEGAR_MURNI, OLAHAN_COKELAT, YOGURT
  productType      String   @default("SEGAR") // "SEGAR" or "OLAHAN"
  defaultPackaging String   @default("botol") // "cup", "pack", "botol", "liter"
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productions MilkProduction[]
  outflows    MilkOutflow[]

  @@map("milk_categories")
}

model MilkProduction {
  id              String   @id @default(uuid())
  date            DateTime @default(now())
  categoryId      String
  category        MilkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productType     String   @default("SEGAR") // "SEGAR" or "OLAHAN"
  packagingType   String   @default("botol") // "cup", "pack", "botol", "liter"
  rawVolumeLiters Float    @default(0) // Input jumlah susu dalam liter (hasil perah)
  processedLiters Float    @default(0) // Input jumlah susu yang diproses/dikemas (liter)
  packagedQty     Int      @default(0) // Input jumlah produk setelah dikemas (botol/cup/pack)
  notes           String?
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("milk_productions")
}

model MilkOutflow {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  categoryId    String
  category      MilkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productType   String   @default("SEGAR") // "SEGAR" or "OLAHAN"
  packagingType String   @default("botol") // "cup", "pack", "botol", "liter"
  quantity      Int      @default(0) // Jumlah produk yang keluar/terjual (botol/cup/pack)
  notes         String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("milk_outflows")
}
