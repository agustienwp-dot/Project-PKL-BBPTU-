generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id          Int     @id @default(autoincrement())
  username    String? @unique @db.VarChar(255)
  password    String? @db.VarChar(255)
  role        String? @db.VarChar(50)
  record_flag String? @default("ACTIVE") @db.VarChar(31)

  @@map("admin")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN_FARM") // SUPERADMIN, ADMIN_FARM, ADMIN_PEMASARAN
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs             SystemLog[]
  productions      MilkProduction[]
  packagings       MilkPackaging[]
  outflows         MilkOutflow[]
  sales            MilkSale[]
  bastDocuments    BastDocument[]
  packagedProducts PackagedProduct[] @relation("UserPackagedProducts")

  @@map("users")
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String
  action    String
  level     String   @default("INFO") // INFO, WARN, ERROR
  details   String?
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model MilkCategory {
  id               String   @id @default(uuid())
  name             String   @unique // e.g. Susu Murni Segar, Susu Olahan Cokelat, Yogurt, Keju
  code             String   @unique // e.g. SEGAR_MURNI, OLAHAN_COKELAT, YOGURT
  productType      String   @default("SEGAR") // "SEGAR" or "OLAHAN"
  animalType       String   @default("SAPI") // "SAPI" or "KAMBING"
  defaultPackaging String   @default("botol") // "cup", "pack", "botol", "liter"
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productions MilkProduction[]
  packagings  MilkPackaging[]
  outflows    MilkOutflow[]

  @@map("milk_categories")
}

model MilkProduction {
  id              String   @id @default(uuid())
  date            DateTime @default(now())
  tanggal         DateTime @default(now())
  categoryId      String?
  category        MilkCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productType     String   @default("SEGAR") // "SEGAR" or "OLAHAN"
  animalType      String   @default("SAPI") // "SAPI" or "KAMBING"
  packagingType   String   @default("botol") // "cup", "pack", "botol", "liter"
  grossVolumeLiters Float    @default(0) // Produksi susu (Gross Liter)
  produksi        Float    @default(0) // alias / total liter diperah
  pedetVolumeLiters Float    @default(0) // Susu untuk Pedet (Sapi) / Cempe (Kambing) (Liter)
  setorPedet      Float    @default(0) // alias setor pedet
  afkirVolumeLiters Float    @default(0) // Susu Afkir / Rusak (Liter)
  rusakAfkir      Float    @default(0) // alias rusak afkir
  usageType       String?  // Ringkasan kegunaan / catatan alokasi
  usageVolumeLiters Float  @default(0) // Total potongan volume (pedet + afkir)
  rawVolumeLiters Float    @default(0) // Hasil akhir yang masuk ke KPI / Pemasaran (gross - pedet - afkir)
  kirimKePI       Float    @default(0) // Jumlah yang dikirim ke PI (feed Pemasaran)
  processedLiters Float    @default(0) // Input jumlah susu yang diproses/dikemas (liter)
  packagedQty     Int      @default(0) // Input jumlah produk setelah dikemas (botol/cup/pack)
  status          String   @default("SELESAI") // "SELESAI"
  notes           String?
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("milk_productions")
}

model PackagedProduct {
  id             String    @id @default(uuid())
  tanggal        DateTime  @default(now())
  jenisProduk    String    // "Susu Rasa" | "Keju" | "Yogurt"
  kemasan        String    // "Botol 250ml" | "Botol 110ml" | "Cup" | "Plastik Bantal"
  jumlah         Float     @default(0)
  status         String    @default("MENUNGGU_PENERIMAAN") // "MENUNGGU_PENERIMAAN", "DITERIMA", "PERLU_KOREKSI"
  receivedAt     DateTime?
  receivedByName String?
  condition      String?   // "Sesuai", "Ada Selisih", "Ada Kerusakan"
  notes          String?   @db.Text
  createdById    String?
  createdBy      User?     @relation("UserPackagedProducts", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("packaged_products")
}

model MilkPackaging {
  id               String   @id @default(uuid())
  date             DateTime @default(now())
  productCategory  String   @default("Susu") // "Susu", "Yogurt", "Keju"
  productSubtype   String?  // "Susu UHT", "Susu Pasteurisasi", "Susu Rasa"
  origin           String   @default("Sapi") // "Sapi", "Kambing"
  variant          String?  // "Original", "Cokelat", "Stroberi", "Melon", "Vanilla", "Keju Fresh", "Keju Olahan", dll.
  animalType       String   @default("SAPI") // "SAPI" or "KAMBING" (compat)
  categoryId       String?
  category         MilkCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  processedAmount  Float    @default(0) // Jumlah liter/kg yang diproses
  processedUnit    String   @default("Liter") // "Liter" or "Kg"
  processedLiters  Float    @default(0) // Quantified in liters for compat
  packagingDetails String?  @db.Text // JSON string: [{ packagingType, size, quantity }]
  packagingType    String?  // Main packaging type e.g. "Botol", "Cup"
  packageSize      String?  // Main package size e.g. "250 ml", "100 gram"
  botolQty         Int      @default(0) // Jumlah pcs botol (compat)
  cupQty           Int      @default(0) // Jumlah pcs cup (compat)
  plastikBantalQty Int      @default(0) // Jumlah pcs plastik bantal (compat)
  totalPackagedQty Int      @default(0) // Total pcs produk jadi
  status           String   @default("DRAFT") // "DRAFT", "MENUNGGU_PENERIMAAN", "DITERIMA", "PERLU_KOREKSI"
  sentAt           DateTime?
  sentById         String?
  sentByName       String?
  receivedAt       DateTime?
  receivedById     String?
  receivedByName   String?
  quantitySent     Int      @default(0) // Total pcs dikirim Farm
  quantityReceived Int      @default(0) // Total pcs dikonfirmasi Pemasaran
  condition        String?  // "Sesuai", "Ada Selisih", "Ada Kerusakan"
  receptionNotes   String?  @db.Text
  notes            String?
  createdById      String?
  createdBy        User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("milk_packagings")
}

model MilkOutflow {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  categoryId    String
  category      MilkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productType   String   @default("SEGAR") // "SEGAR" or "OLAHAN"
  animalType    String   @default("SAPI") // "SAPI" or "KAMBING"
  packagingType String   @default("botol") // "cup", "pack", "botol", "liter"
  quantity      Int      @default(0) // Jumlah produk yang keluar/terjual (botol/cup/pack)
  notes         String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("milk_outflows")
}

model MilkSale {
  id              String   @id @default(uuid())
  transactionId   String?  @unique // e.g. TRX-20260814-001
  date            DateTime @default(now())
  tanggal         DateTime @default(now())
  sumber          String   @default("FRESH") // "FRESH" | "OLAHAN"
  produkRefId     String?  // relasi ke PackagedProduct.id
  jumlah          Float    @default(0)
  pembeli         String   @default("")
  hargaJual       Float    @default(0)
  kategoriBayar   String   @default("PNBP") // "PNBP" | "PIUTANG"
  catatan         String?
  productCategory String   @default("Susu") // "Susu", "Yogurt", "Keju"
  productSubtype  String?  // "Susu UHT", "Susu Pasteurisasi", "Susu Rasa", etc.
  variant         String?  // "Original", "Cokelat", etc.
  packagingType   String   @default("Botol") // "Botol", "Cup", "Plastik Bantal", etc.
  quantity        Int      @default(0) // Jumlah pcs
  unitPrice       Float    @default(0) // Harga per pcs
  totalPrice      Float    @default(0) // Total Rp
  status          String   @default("Berhasil") // "Berhasil", "Dibatalkan"
  notes           String?
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  piutang         Piutang?

  @@map("milk_sales")
}

model Piutang {
  id            String   @id @default(uuid())
  milkSaleId    String   @unique
  milkSale      MilkSale @relation(fields: [milkSaleId], references: [id], onDelete: Cascade)
  jumlahAwal    Float
  sisaPiutang   Float
  lunas         Boolean  @default(false)
  createdAt     DateTime @default(now())

  pelunasan     PelunasanPiutang[]

  @@map("piutang")
}

model PelunasanPiutang {
  id         String   @id @default(uuid())
  piutangId  String
  piutang    Piutang  @relation(fields: [piutangId], references: [id], onDelete: Cascade)
  jumlah     Float
  tanggal    DateTime @default(now())
  catatan    String?

  @@map("pelunasan_piutang")
}

model BastDocument {
  id               String    @id @default(uuid())
  nomorBast        String    @unique // e.g. BAST/BBPTU/20260819/0001
  tanggal          DateTime  @default(now())
  sumber           String    @default("SUSU_SEGAR") // SUSU_SEGAR / SUSU_MENTAH
  volumeLiters     Float     @default(0)
  jenisPermintaan  String    @default("PENJUALAN_LANGSUNG") // PENJUALAN_LANGSUNG, HIBAH, KERJASAMA, PERMINTAAN_DINAS
  instansiPenerima String?   // Pembeli / Instansi / Penerima Hibah
  pengirimNama     String
  pengirimRole     String    @default("ADMIN_FARM")
  penerimaNama     String?
  penerimaRole     String?   @default("ADMIN_PEMASARAN")
  status           String    @default("MENUNGGU_KONFIRMASI") // MENUNGGU_KONFIRMASI, DITERIMA, DITOLAK
  catatan          String?   @db.Text
  confirmedAt      DateTime?
  productionId     String?
  createdById      String?
  createdBy        User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("bast_documents")
}
