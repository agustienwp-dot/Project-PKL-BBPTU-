// Prisma Schema for Farm Management & Livestock Sales System
// Provider: SQLite (configured for seamless zero-config local development)
// To use PostgreSQL: Change provider to "postgresql" and set DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      String     @default("STAFF") // ADMIN, STAFF
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]

  @@map("users")
}

model Cage {
  id            String           @id @default(uuid())
  name          String
  type          String
  location      String
  capacity      Int
  description   String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  animals       Animal[]
  movementsFrom AnimalMovement[] @relation("FromCage")
  movementsTo   AnimalMovement[] @relation("ToCage")

  @@map("cages")
}

model Animal {
  id                    String                @id @default(uuid())
  code                  String                @unique
  name                  String
  type                  String
  breed                 String
  gender                String
  birthDate             DateTime?
  weight                Float
  healthStatus          String                @default("Sehat")
  purchasePrice         Float
  estimatedSellingPrice Float?
  status                String                @default("AVAILABLE") // AVAILABLE, SOLD, DECEASED, TRANSFERRED
  cageId                String
  cage                  Cage                  @relation(fields: [cageId], references: [id])
  entryDate             DateTime              @default(now())
  origin                String?
  notes                 String?
  photo                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  sale                  Sale?
  weightHistories       AnimalWeightHistory[]
  movements             AnimalMovement[]

  @@map("animals")
}

model Buyer {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@map("buyers")
}

model Sale {
  id            String   @id @default(uuid())
  animalId      String   @unique
  animal        Animal   @relation(fields: [animalId], references: [id])
  buyerId       String
  buyer         Buyer    @relation(fields: [buyerId], references: [id])
  saleDate      DateTime @default(now())
  weightAtSale  Float
  sellingPrice  Float
  paymentMethod String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sales")
}

model AnimalWeightHistory {
  id         String   @id @default(uuid())
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  weight     Float
  recordedAt DateTime @default(now())
  notes      String?

  @@map("animal_weight_histories")
}

model AnimalMovement {
  id         String   @id @default(uuid())
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  fromCageId String
  fromCage   Cage     @relation("FromCage", fields: [fromCageId], references: [id])
  toCageId   String
  toCage     Cage     @relation("ToCage", fields: [toCageId], references: [id])
  movedAt    DateTime @default(now())
  notes      String?

  @@map("animal_movements")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
