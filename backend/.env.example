# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/farm_management?schema=public"

# SQLite Alternative (for quick testing without local Postgres):
# 1. Change provider in prisma/schema.prisma to "sqlite"
# 2. Set DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET="farm-management-jwt-secret-key-2026"
JWT_EXPIRES_IN="1d"
